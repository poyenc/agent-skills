#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/rotate-common.sh
source "$HERE/rotate-common.sh"

rotate_guard || { rotate_note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }

target=""
args=("$@"); i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    --name|--model|--effort|--kickoff) i=$((i+2)) ;;   # flag + its value
    --) i=$((i+1)) ;;
    -*) i=$((i+1)) ;;                                   # valueless flag (e.g. --no-kickoff)
    *) target="${args[$i]}"; break ;;
  esac
done
[ -n "$target" ] || rotate_die "usage: herdr-rotate <name-or-pane> [--name N] [--model M] [--effort E] [--kickoff MSG] [--no-kickoff]"
rotate_resolve "$target"
script="$HERE/herdr-rotate-$ROTATE_KIND"
[ -x "$script" ] || rotate_die "unsupported kind: $ROTATE_KIND"
exec "$script" "$@"
