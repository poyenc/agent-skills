#!/usr/bin/env bash
#
# monorepo-bridge — Bidirectional commit transfer between a monorepo
# and standalone submodule repos.
#
# Usage:
#   monorepo-bridge <command> [options] [args]
#
# Commands:
#   setup    Set up the bridge between a submodule and its monorepo
#   split    Split a monorepo subdirectory into a standalone branch
#   export   Export submodule commits into the monorepo (fetch + subtree merge)
#   sync     Pull latest monorepo changes into the submodule (split + rebase)
#   reset    Reset all three branches to undo an export
#   verify   Verify all three branches are in sync
#
# Run 'monorepo-bridge <command> --help' for command-specific usage.

set -euo pipefail

PROG="monorepo-bridge"
VERSION="0.1.0"

# --- Interactive helpers ------------------------------------------------------

# Prompt user for confirmation. Returns 0 (yes) or 1 (no).
# In non-interactive mode (stdin is not a terminal), defaults to yes.
confirm_prompt() {
    local prompt="$1"
    if [[ ! -t 0 ]]; then
        # Non-interactive: default to yes
        echo "${prompt} [Y/n] (auto-confirmed, non-interactive)" >&2
        return 0
    fi
    local reply
    read -rp "${prompt} [Y/n] " reply
    [[ ! "${reply}" =~ ^[Nn] ]]
}

# Prompt user for text input. In non-interactive mode, returns empty string.
read_input() {
    local prompt="$1"
    if [[ ! -t 0 ]]; then
        echo "" # no input available
        return
    fi
    local reply
    read -rp "${prompt}" reply
    echo "${reply}"
}

# --- Config helpers -----------------------------------------------------------

# Read a bridge config value. Resolution order:
#   1. Variable override (caller sets BRIDGE_<KEY> before calling)
#   2. Git config (bridge.<key>)
#   3. Default value (third argument)
# Returns empty string and exit 1 if no value found and no default.
bridge_config_get() {
    local key="$1"
    local var_name="BRIDGE_$(echo "${key}" | tr '[:lower:]-' '[:upper:]_')"
    local default="${2:-}"

    # 1. Check variable override
    if [[ -n "${!var_name:-}" ]]; then
        echo "${!var_name}"
        return 0
    fi

    # 2. Check git config
    local val
    if val=$(git config --local --get "bridge.${key}" 2>/dev/null) && [[ -n "${val}" ]]; then
        echo "${val}"
        return 0
    fi

    # 3. Default
    if [[ -n "${default}" ]]; then
        echo "${default}"
        return 0
    fi

    return 1
}

# Write a bridge config value to local git config.
bridge_config_set() {
    local key="$1"
    local value="$2"
    git config --local "bridge.${key}" "${value}"
}

# Resolve the monorepo path from config, stripping file:// prefix if present.
resolve_monorepo_path() {
    local path
    if ! path=$(bridge_config_get "monorepo-path"); then
        echo "ERROR: No monorepo path configured. Run '${PROG} setup' first." >&2
        return 1
    fi
    # Strip file:// prefix if present (from blobless setup)
    path="${path#file://}"
    echo "${path}"
}

# Detect if a remote is blobless (file:// URL from partial clone setup).
is_blobless_remote() {
    local remote="$1"
    local url
    url=$(git remote get-url "${remote}" 2>/dev/null || true)
    [[ "${url}" == file://* ]]
}

# --- Auto-detect bridge config from existing remotes --------------------------

# Try to infer bridge config from an existing remote that points to a monorepo
# with split branches. Sets bridge.remote, bridge.monorepo-path, bridge.prefix,
# and bridge.split-prefix in local git config if found.
# Returns 0 if config was detected, 1 otherwise.
bridge_config_auto_detect() {
    # Already configured?
    if bridge_config_get "remote" &>/dev/null && bridge_config_get "monorepo-path" &>/dev/null; then
        return 0
    fi

    echo "==> No bridge config found. Scanning existing remotes..." >&2

    # Look for a remote whose refspec fetches split branches
    # Pattern: +refs/heads/<split-prefix>/*:refs/remotes/<remote>/*
    local remote_name="" split_prefix="" monorepo_url=""
    while IFS= read -r line; do
        local name fetch_spec
        name="${line%%:*}"
        # Get the fetch refspec for this remote
        fetch_spec=$(git config --get "remote.${name}.fetch" 2>/dev/null || true)
        [[ -z "${fetch_spec}" ]] && continue

        # Check if the refspec maps split branches: +refs/heads/<prefix>/*:refs/remotes/<name>/*
        # The split prefix can contain multiple path components (e.g., "ck-split" or "bridge/split")
        local escaped_name
        escaped_name=$(printf '%s' "${name}" | sed 's/[.[\*^$()+?{|\\]/\\&/g')
        if [[ "${fetch_spec}" =~ ^\+refs/heads/(.+)/\*:refs/remotes/${escaped_name}/\*$ ]]; then
            local candidate_prefix="${BASH_REMATCH[1]}"
            # Verify this remote actually has branches
            if git branch -r --list "${name}/*" 2>/dev/null | head -1 | grep -q .; then
                remote_name="${name}"
                split_prefix="${candidate_prefix}"
                monorepo_url=$(git remote get-url "${name}" 2>/dev/null || true)
                break
            fi
        fi
    done < <(git remote 2>/dev/null | while read -r r; do echo "${r}:"; done)

    if [[ -z "${remote_name}" ]]; then
        echo "    No suitable remote found." >&2
        return 1
    fi

    # Resolve monorepo path from URL
    local monorepo_path="${monorepo_url}"
    monorepo_path="${monorepo_path#file://}"
    if [[ ! -d "${monorepo_path}/.git" ]] && [[ ! -f "${monorepo_path}/.git" ]]; then
        echo "    Remote '${remote_name}' URL '${monorepo_url}' is not a local path." >&2
        return 1
    fi

    # Auto-detect prefix from monorepo
    local prefix=""
    prefix=$(auto_detect_prefix "${monorepo_path}" 2>/dev/null) || {
        echo "    Could not auto-detect prefix in monorepo at ${monorepo_path}." >&2
        return 1
    }

    echo "    Detected bridge config from remote '${remote_name}':" >&2
    echo "      monorepo-path: ${monorepo_path}" >&2
    echo "      prefix:        ${prefix}" >&2
    echo "      split-prefix:  ${split_prefix}" >&2

    # Ask user to confirm
    if ! confirm_prompt "    Use these settings?"; then
        echo "    Skipped. Run '${PROG} setup' to configure manually." >&2
        return 1
    fi

    # Save to git config
    bridge_config_set "remote" "${remote_name}"
    bridge_config_set "monorepo-path" "${monorepo_path}"
    bridge_config_set "prefix" "${prefix}"
    bridge_config_set "split-prefix" "${split_prefix}"
    echo "    Saved bridge config." >&2

    return 0
}

# Ensure bridge config is available, auto-detecting if needed.
# Call this at the start of commands that need bridge config.
require_bridge_config() {
    if bridge_config_get "remote" &>/dev/null \
        && bridge_config_get "monorepo-path" &>/dev/null \
        && bridge_config_get "prefix" &>/dev/null; then
        return 0
    fi
    bridge_config_auto_detect || {
        echo "ERROR: No bridge configuration. Run '${PROG} setup' first." >&2
        return 1
    }
}

# --- Subcommand: setup -------------------------------------------------------

cmd_setup() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} setup [options] [monorepo-path]"
        echo ""
        echo "Set up the bridge between a submodule repo and its monorepo."
        echo "Run this inside the submodule directory."
        echo ""
        echo "Options:"
        echo "  --prefix=<path>        Subdirectory prefix in monorepo"
        echo "  --remote=<name>        Remote name (default: bridge-upstream)"
        echo "  --split-prefix=<name>  Branch prefix for split branches (default: bridge-split)"
        echo ""
        echo "If monorepo-path is omitted, auto-detection is attempted."
        exit 0
    fi

    local monorepo_path=""
    local prefix_override=""
    local remote_override=""
    local split_prefix_override=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --prefix=*) prefix_override="${1#--prefix=}"; shift ;;
            --remote=*) remote_override="${1#--remote=}"; shift ;;
            --split-prefix=*) split_prefix_override="${1#--split-prefix=}"; shift ;;
            -*) echo "ERROR: Unknown option: $1" >&2; exit 1 ;;
            *) monorepo_path="$(realpath "$1" 2>/dev/null || echo "$1")"; shift ;;
        esac
    done

    # Validate we're in a git repo
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "ERROR: Not inside a git repository. cd into your submodule first." >&2
        exit 1
    fi

    # Auto-detect monorepo path if not provided
    if [[ -z "${monorepo_path}" ]]; then
        monorepo_path=$(auto_detect_monorepo_path) || {
            echo "ERROR: Could not auto-detect monorepo path." >&2
            echo "       Pass it explicitly: ${PROG} setup /path/to/monorepo" >&2
            exit 1
        }
    fi

    # Validate monorepo path is a git repo
    if [[ ! -d "${monorepo_path}/.git" ]] && [[ ! -f "${monorepo_path}/.git" ]]; then
        echo "ERROR: '${monorepo_path}' is not a git repository." >&2
        exit 1
    fi

    # Resolve config values
    local remote="${remote_override:-$(bridge_config_get remote "bridge-upstream")}"
    local split_prefix="${split_prefix_override:-$(bridge_config_get split-prefix "bridge-split")}"

    # Auto-detect or use provided prefix
    local prefix=""
    if [[ -n "${prefix_override}" ]]; then
        prefix="${prefix_override}"
    else
        prefix=$(auto_detect_prefix "${monorepo_path}") || {
            echo "ERROR: Could not auto-detect prefix." >&2
            echo "       Pass it explicitly: ${PROG} setup --prefix=<path> ${monorepo_path}" >&2
            exit 1
        }
    fi

    # Validate prefix exists in monorepo
    if [[ ! -d "${monorepo_path}/${prefix}" ]]; then
        echo "ERROR: '${monorepo_path}/${prefix}' not found." >&2
        exit 1
    fi

    echo "==> Setting up monorepo bridge"
    echo "    Monorepo:      ${monorepo_path}"
    echo "    Prefix:        ${prefix}"
    echo "    Remote:        ${remote}"
    echo "    Split prefix:  ${split_prefix}"

    # Add or update remote
    if git remote get-url "${remote}" &>/dev/null; then
        local existing_url
        existing_url=$(git remote get-url "${remote}")
        echo ""
        echo "    Remote '${remote}' already exists (url: ${existing_url})"
        echo "    Updating URL to ${monorepo_path}"
        git remote set-url "${remote}" "${monorepo_path}"
    else
        echo ""
        echo "    Adding remote '${remote}' -> ${monorepo_path}"
        git remote add "${remote}" "${monorepo_path}"
    fi

    # Configure fetch refspec for split branches
    git config "remote.${remote}.fetch" "+refs/heads/${split_prefix}/*:refs/remotes/${remote}/*"

    # Handle partial/blobless clone
    echo ""
    echo "==> Fetching from '${remote}'..."
    if git -C "${monorepo_path}" config --get remote.origin.partialclonefilter &>/dev/null; then
        echo "    (source repo is a partial clone, using blobless fetch)"
        git remote set-url "${remote}" "file://${monorepo_path}"
        git -C "${monorepo_path}" config uploadpack.allowFilter true
        git fetch --filter=blob:none "${remote}"
    else
        git fetch "${remote}"
    fi

    # Save config
    bridge_config_set "prefix" "${prefix}"
    bridge_config_set "remote" "${remote}"
    bridge_config_set "monorepo-path" "${monorepo_path}"
    bridge_config_set "split-prefix" "${split_prefix}"

    echo ""
    echo "==> Bridge configured. Available branches:"
    git branch -r --list "${remote}/*" || echo "    (none — run '${PROG} split' in the monorepo first)"

    echo ""
    echo "You can now:"
    echo "  ${PROG} export [target-branch]     # export commits to the monorepo"
    echo "  ${PROG} sync [monorepo-branch]     # pull monorepo changes into submodule"
    echo "  git merge ${remote}/<branch>       # merge a split branch"
}

# Auto-detect the monorepo path by inspecting submodule context.
auto_detect_monorepo_path() {
    # Check if we're inside a submodule (`.git` is a file, not a directory)
    if [[ ! -f ".git" ]]; then
        return 1
    fi

    # Read the gitdir from the .git file to find the parent repo
    local gitdir
    gitdir=$(sed -n 's/^gitdir: //p' .git)
    if [[ -z "${gitdir}" ]]; then
        return 1
    fi

    # Walk up from gitdir to find the parent repo root
    # gitdir is typically: ../../.git/modules/<submodule-name>
    local parent_git_dir
    parent_git_dir=$(cd "$(dirname "${gitdir}")" && pwd)
    # Navigate up past .git/modules/<name> to reach the parent work tree
    local parent_repo
    parent_repo=$(git -C "${parent_git_dir}" rev-parse --show-toplevel 2>/dev/null) || return 1

    # Read .gitmodules from the parent to find the submodule's URL
    local submodule_url
    submodule_url=$(git config --file "${parent_repo}/.gitmodules" --get-regexp 'submodule\..*\.url' 2>/dev/null | head -1 | awk '{print $2}') || return 1

    # Scan sibling directories of the parent repo for monorepos
    local parent_parent
    parent_parent=$(dirname "${parent_repo}")

    local candidates=()
    for dir in "${parent_parent}"/*/; do
        [[ -d "${dir}/.git" || -f "${dir}/.git" ]] || continue
        [[ "$(realpath "${dir}")" == "$(realpath "${parent_repo}")" ]] && continue

        # Check if this repo has .gitmodules referencing a similar URL
        # or has subdirectories that could be the prefix
        if [[ -f "${dir}/.gitmodules" ]] || find "${dir}" -maxdepth 2 -name ".gitmodules" -print -quit 2>/dev/null | grep -q .; then
            candidates+=("$(realpath "${dir}")")
        fi
    done

    if [[ ${#candidates[@]} -eq 1 ]]; then
        echo "${candidates[0]}"
        return 0
    elif [[ ${#candidates[@]} -gt 1 ]]; then
        echo "Multiple candidate monorepos found:" >&2
        local i=1
        for c in "${candidates[@]}"; do
            echo "  ${i}) ${c}" >&2
            i=$((i + 1))
        done
        echo "" >&2
        local choice
        choice=$(read_input "Choose [1-${#candidates[@]}]: ")
        if [[ -z "${choice}" ]]; then
            return 1
        fi
        echo "${candidates[$((choice - 1))]}"
        return 0
    fi

    return 1
}

# Normalize a name for fuzzy matching: lowercase, strip hyphens/underscores.
# e.g., "composable_kernel" and "composablekernel" both become "composablekernel"
normalize_name() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr -d '_-'
}

# Auto-detect the prefix by matching the submodule's origin URL against
# .gitmodules entries or directory names in the monorepo.
auto_detect_prefix() {
    local monorepo_path="$1"

    # Get the submodule's origin URL
    local sub_url
    sub_url=$(git remote get-url origin 2>/dev/null) || return 1

    # Extract just the repo name from the URL for matching
    local sub_name
    sub_name=$(basename "${sub_url}" .git)
    local sub_name_normalized
    sub_name_normalized=$(normalize_name "${sub_name}")

    # Check monorepo's .gitmodules for a matching submodule URL
    if [[ -f "${monorepo_path}/.gitmodules" ]]; then
        local prefix
        prefix=$(git config --file "${monorepo_path}/.gitmodules" --get-regexp 'submodule\..*\.url' 2>/dev/null | while read -r key url; do
            local entry_name
            entry_name=$(basename "${url}" .git)
            if [[ "${entry_name}" == "${sub_name}" ]]; then
                # Extract the submodule path from the key
                local sub_key="${key%.url}"
                sub_key="${sub_key}.path"
                git config --file "${monorepo_path}/.gitmodules" --get "${sub_key}" 2>/dev/null
                break
            fi
        done) || true

        if [[ -n "${prefix}" ]]; then
            echo "${prefix}"
            return 0
        fi
    fi

    # Fallback: scan top-level directories for exact or fuzzy name match
    for dir in "${monorepo_path}"/*/; do
        [[ -d "${dir}" ]] || continue
        local dirname
        dirname=$(basename "${dir}")
        if [[ "${dirname}" == "${sub_name}" ]] \
            || [[ "$(normalize_name "${dirname}")" == "${sub_name_normalized}" ]]; then
            echo "${dirname}"
            return 0
        fi
    done

    # Fallback: scan two levels deep with fuzzy match
    for dir in "${monorepo_path}"/*/*/; do
        [[ -d "${dir}" ]] || continue
        local dirname
        dirname=$(basename "${dir}")
        if [[ "${dirname}" == "${sub_name}" ]] \
            || [[ "$(normalize_name "${dirname}")" == "${sub_name_normalized}" ]]; then
            local rel_path="${dir#"${monorepo_path}/"}"
            rel_path="${rel_path%/}"
            echo "${rel_path}"
            return 0
        fi
    done

    return 1
}

# --- Subcommand: split --------------------------------------------------------

cmd_split() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} split [options] [source-branch]"
        echo ""
        echo "Split a monorepo subdirectory into a standalone branch."
        echo "Run this from the root of the monorepo."
        echo ""
        echo "Options:"
        echo "  --rejoin               Record split point for incremental future splits"
        echo "  --prefix=<path>        Subdirectory prefix (default: from git config)"
        echo "  --split-prefix=<name>  Branch prefix (default: bridge-split)"
        echo ""
        echo "If source-branch is omitted, the current branch is used."
        echo ""
        echo "WARNING: --rejoin modifies the source branch by adding a merge commit."
        exit 0
    fi

    local rejoin=false
    local source_branch=""
    local prefix_override=""
    local split_prefix_override=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --rejoin) rejoin=true; shift ;;
            --prefix=*) prefix_override="${1#--prefix=}"; shift ;;
            --split-prefix=*) split_prefix_override="${1#--split-prefix=}"; shift ;;
            -*) echo "ERROR: Unknown option: $1" >&2; exit 1 ;;
            *) source_branch="$1"; shift ;;
        esac
    done

    # Resolve prefix — from override, git config, or auto-detect
    local prefix=""
    if [[ -n "${prefix_override}" ]]; then
        prefix="${prefix_override}"
    elif prefix=$(bridge_config_get "prefix" 2>/dev/null) && [[ -n "${prefix}" ]]; then
        : # already set
    else
        # First-run auto-detection for monorepo side
        echo "No bridge.prefix configured. Scanning for project directories..." >&2

        # Strategy 1: Look for nested git repos (submodule-style)
        local candidates=()
        while IFS= read -r -d '' dir; do
            candidates+=("${dir#./}")
        done < <(find . -maxdepth 3 -name ".git" -not -path "./.git" -printf "%h\0" 2>/dev/null)

        # Strategy 2: If no nested git repos found, look for directories
        # containing a CMakeLists.txt (common project root marker)
        if [[ ${#candidates[@]} -eq 0 ]]; then
            while IFS= read -r -d '' dir; do
                local rel="${dir#./}"
                rel="${rel%/CMakeLists.txt}"
                # Skip the monorepo root's own CMakeLists.txt
                [[ "${rel}" == "." || "${rel}" == "" ]] && continue
                # Only include if it looks like a project (has src/ or include/ or lib/)
                if [[ -d "./${rel}/include" || -d "./${rel}/src" || -d "./${rel}/lib" ]]; then
                    candidates+=("${rel}")
                fi
            done < <(find . -maxdepth 3 -name "CMakeLists.txt" -not -path "./CMakeLists.txt" -printf "%p\0" 2>/dev/null)
        fi

        if [[ ${#candidates[@]} -eq 0 ]]; then
            echo "ERROR: Could not auto-detect prefix. Use --prefix=<path>." >&2
            exit 1
        elif [[ ${#candidates[@]} -eq 1 ]]; then
            prefix="${candidates[0]}"
            echo "Auto-detected prefix: ${prefix}" >&2
        else
            echo "Multiple candidates found:" >&2
            local i=1
            for c in "${candidates[@]}"; do
                echo "  ${i}) ${c}" >&2
                i=$((i + 1))
            done
            local choice
            choice=$(read_input "Choose [1-${#candidates[@]}]: ")
            if [[ -z "${choice}" ]]; then
                echo "ERROR: No selection made (non-interactive). Use --prefix=<path>." >&2
                exit 1
            fi
            prefix="${candidates[$((choice - 1))]}"
        fi

        bridge_config_set "prefix" "${prefix}"
    fi

    local split_prefix="${split_prefix_override:-$(bridge_config_get split-prefix "bridge-split")}"

    # Default source branch to current branch
    if [[ -z "${source_branch}" ]]; then
        source_branch=$(git rev-parse --abbrev-ref HEAD)
    fi

    local split_branch="${split_prefix}/${source_branch}"

    echo "==> Splitting '${prefix}' from '${source_branch}'"
    echo "    into branch '${split_branch}'"
    echo ""

    # Validate prefix exists
    if [[ ! -d "${prefix}" ]]; then
        echo "ERROR: '${prefix}' not found. Run this from the monorepo root." >&2
        exit 1
    fi

    # Build split command
    local rejoin_flag=()
    if [[ "${rejoin}" == true ]]; then
        rejoin_flag=(--rejoin)
    fi

    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    if [[ "${rejoin}" == true && "${current_branch}" != "${source_branch}" ]]; then
        echo "    (checking out '${source_branch}' for --rejoin)"
        git checkout "${source_branch}"
        local split_sha
        split_sha=$(git subtree split --prefix="${prefix}" --branch="${split_branch}" "${rejoin_flag[@]}")
        echo "    (switching back to '${current_branch}')"
        git checkout "${current_branch}"
    else
        local split_sha
        split_sha=$(git subtree split --prefix="${prefix}" --branch="${split_branch}" "${rejoin_flag[@]}" "${source_branch}")
    fi

    echo ""
    echo "==> Done. Branch '${split_branch}' now at ${split_sha}"
    echo ""
    echo "In your submodule repo, you can now do:"
    echo "  ${PROG} setup ${PWD}"
    echo "  git fetch $(bridge_config_get remote "bridge-upstream") ${split_branch}"
}

# --- Subcommand: export ------------------------------------------------------

cmd_export() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} export [target-branch]"
        echo ""
        echo "Export commits from the submodule into the monorepo."
        echo "Run this inside the submodule directory."
        echo ""
        echo "Steps performed:"
        echo "  1. Fetch submodule commits into monorepo (no remote added)"
        echo "  2. Update split branch to fetched commits (identical hashes)"
        echo "  3. Subtree-merge split branch into monorepo tracking branch"
        echo ""
        echo "Preserves identical commit hashes between split and submodule."
        echo "Creates a merge commit on the monorepo branch."
        echo ""
        echo "Arguments:"
        echo "  target-branch   Branch in monorepo to apply to (default: tracked branch)"
        exit 0
    fi

    local target_branch_override="${1:-}"

    # Read config (auto-detect from existing remotes if needed)
    require_bridge_config || exit 1
    local monorepo_path
    monorepo_path=$(resolve_monorepo_path) || exit 1
    local prefix
    prefix=$(bridge_config_get "prefix")
    local split_prefix
    split_prefix=$(bridge_config_get "split-prefix" "bridge-split")

    # Validate monorepo path and prefix
    if [[ ! -d "${monorepo_path}/${prefix}" ]]; then
        echo "ERROR: '${monorepo_path}/${prefix}' not found." >&2
        echo "       Is '${monorepo_path}' the root of the monorepo?" >&2
        exit 1
    fi

    # Resolve target branch
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    local target_branch=""
    if [[ -n "${target_branch_override}" ]]; then
        target_branch="${target_branch_override}"
    elif target_branch=$(git config --local --get "branch.${current_branch}.bridge-tracks" 2>/dev/null) && [[ -n "${target_branch}" ]]; then
        : # already set
    else
        target_branch="${current_branch}"
    fi

    local sub_sha
    sub_sha=$(git rev-parse HEAD)
    local split_branch="${split_prefix}/${target_branch}"

    # Find the base: where split branch currently points (last exported commit)
    local split_sha=""
    split_sha=$(git -C "${monorepo_path}" rev-parse "${split_branch}" 2>/dev/null || echo "")

    if [[ "${split_sha}" == "${sub_sha}" ]]; then
        echo "==> Split branch '${split_branch}' already up to date with submodule HEAD."
        echo "    Nothing to export."
        exit 0
    fi

    # Count new commits
    local new_count=0
    if [[ -n "${split_sha}" ]]; then
        new_count=$(git rev-list --count "${split_sha}..HEAD")
    else
        echo "ERROR: Split branch '${split_branch}' not found in monorepo." >&2
        echo "       Run '${PROG} split' in the monorepo first, or '${PROG} sync' to set up." >&2
        exit 1
    fi

    echo "==> Exporting ${new_count} commit(s) from '${current_branch}'"
    echo "    Base (split):   ${split_sha:0:12}"
    echo "    Submodule HEAD: ${sub_sha:0:12}"
    echo "    Target branch:  ${target_branch}"
    echo ""

    # Step 1: Fetch submodule commits into monorepo object store (no remote added)
    local sub_toplevel
    sub_toplevel=$(git rev-parse --show-toplevel)
    echo "==> Fetching submodule commits into monorepo..."
    git -C "${monorepo_path}" fetch "${sub_toplevel}" "${current_branch}" 2>&1

    # Step 2: Update split branch to point at fetched commits (identical hashes)
    echo ""
    echo "==> Updating split branch '${split_branch}'..."
    git -C "${monorepo_path}" branch -f "${split_branch}" FETCH_HEAD 2>&1

    # Step 3: Subtree-merge split branch into monorepo tracking branch
    local mono_current_branch
    mono_current_branch=$(git -C "${monorepo_path}" rev-parse --abbrev-ref HEAD)
    local need_restore=false

    if [[ "${mono_current_branch}" != "${target_branch}" ]]; then
        git -C "${monorepo_path}" checkout "${target_branch}" 2>&1
        need_restore=true
    fi

    echo "==> Merging into monorepo branch '${target_branch}'..."
    local merge_msg="Merge ${current_branch} (${new_count} commit(s)) into ${target_branch}"
    git -C "${monorepo_path}" merge -s subtree --allow-unrelated-histories \
        "${split_branch}" -m "${merge_msg}" 2>&1

    # Restore monorepo to its original branch
    if [[ "${need_restore}" == true ]]; then
        git -C "${monorepo_path}" checkout "${mono_current_branch}" 2>/dev/null || true
    fi

    echo ""
    echo "==> Done! Exported ${new_count} commit(s) to '${target_branch}' in monorepo."
    echo ""
    echo "    cd ${monorepo_path}"
    git -C "${monorepo_path}" log --oneline -$((new_count + 2)) "${target_branch}"

    # Post-export: verify sync
    echo ""
    echo "==> Verifying sync..."
    cmd_verify "${target_branch}" || true

    # Offer to push (only if monorepo has a remote)
    local mono_remote
    mono_remote=$(git -C "${monorepo_path}" remote 2>/dev/null | head -1)
    if [[ -n "${mono_remote}" ]]; then
        echo ""
        if confirm_prompt "Push '${target_branch}' to ${mono_remote}?"; then
            git -C "${monorepo_path}" push "${mono_remote}" "${target_branch}" 2>&1
        fi
    fi
}

# --- Subcommand: sync ---------------------------------------------------------

cmd_sync() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} sync [monorepo-branch]"
        echo ""
        echo "Pull latest changes from the monorepo remote into the current"
        echo "submodule branch. Run this inside the submodule directory."
        echo ""
        echo "Steps performed:"
        echo "  1. Detect the matching monorepo branch (via split-branch mapping)"
        echo "  2. Fetch the monorepo branch from its remote (origin)"
        echo "  3. Fast-forward the monorepo's local branch"
        echo "  4. Re-split the updated branch"
        echo "  5. Fetch the updated split into the submodule"
        echo "  6. Rebase local work onto the updated split branch"
        echo ""
        echo "Arguments:"
        echo "  monorepo-branch   Branch name in monorepo (auto-detected from split"
        echo "                    branch tracking if omitted)"
        exit 0
    fi

    local mono_branch_override="${1:-}"

    # Read config (auto-detect from existing remotes if needed)
    require_bridge_config || exit 1
    local remote
    remote=$(bridge_config_get "remote")
    local monorepo_path
    monorepo_path=$(resolve_monorepo_path) || exit 1
    local prefix
    prefix=$(bridge_config_get "prefix")
    local split_prefix
    split_prefix=$(bridge_config_get "split-prefix" "bridge-split")

    # Detect the monorepo branch
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    # Config key: branch.<sub-branch>.bridge-tracks = <mono-branch>
    local track_key="branch.${current_branch}.bridge-tracks"

    local mono_branch=""
    if [[ -n "${mono_branch_override}" ]]; then
        mono_branch="${mono_branch_override}"
        # Save the explicit mapping for future runs
        git config --local "${track_key}" "${mono_branch}"
        echo "==> Saved tracking: ${current_branch} -> ${mono_branch}"
    elif mono_branch=$(git config --local --get "${track_key}" 2>/dev/null) && [[ -n "${mono_branch}" ]]; then
        echo "==> Using tracked monorepo branch: ${mono_branch}"
    else
        # Auto-detect: find which split branch is closest by commit distance
        echo "==> Auto-detecting monorepo branch..."

        local best_branch=""
        local best_count=999999

        while IFS= read -r split_branch; do
            split_branch="${split_branch#"${split_branch%%[![:space:]]*}"}"  # trim whitespace
            [[ -z "${split_branch}" ]] && continue

            local base
            base=$(git merge-base HEAD "${split_branch}" 2>/dev/null || true)
            if [[ -n "${base}" ]]; then
                local count
                count=$(git rev-list --count "${base}..HEAD" 2>/dev/null || echo 999999)
                if [[ "${count}" -lt "${best_count}" ]]; then
                    best_count="${count}"
                    best_branch="${split_branch}"
                fi
            fi
        done < <(git branch -r --list "${remote}/*")

        if [[ -z "${best_branch}" ]]; then
            echo "ERROR: Could not detect monorepo branch. Specify it explicitly:" >&2
            echo "       ${PROG} sync <monorepo-branch>" >&2
            exit 1
        fi

        # Strip remote prefix to get the monorepo branch name
        # e.g., "rocm-ck/users/poyenc/batch-prefill-v3" -> "users/poyenc/batch-prefill-v3"
        mono_branch="${best_branch#"${remote}/"}"
        echo "    Detected: ${mono_branch} (via ${best_branch})"

        # Ask user to confirm
        if ! confirm_prompt "    Use '${mono_branch}' as the tracked monorepo branch?"; then
            mono_branch=$(read_input "    Enter monorepo branch name: ")
            if [[ -z "${mono_branch}" ]]; then
                echo "ERROR: No branch specified." >&2
                exit 1
            fi
        fi

        # Save for future runs
        git config --local "${track_key}" "${mono_branch}"
        echo "    Saved tracking: ${current_branch} -> ${mono_branch}"
    fi

    local split_branch_name="${split_prefix}/${mono_branch}"
    local remote_split="${remote}/${mono_branch}"

    # Detect the monorepo's upstream remote (first remote, usually "origin")
    local mono_remote
    mono_remote=$(git -C "${monorepo_path}" remote 2>/dev/null | head -1)
    if [[ -z "${mono_remote}" ]]; then
        echo "ERROR: No remotes configured in monorepo at ${monorepo_path}." >&2
        exit 1
    fi

    # Step 1: Fetch the monorepo branch from its remote
    echo ""
    echo "==> Fetching monorepo branch '${mono_branch}' from ${mono_remote}..."
    git -C "${monorepo_path}" fetch "${mono_remote}" "${mono_branch}" 2>&1 || {
        echo "ERROR: Failed to fetch '${mono_branch}' from monorepo ${mono_remote}." >&2
        exit 1
    }

    # Step 2: Fast-forward the monorepo's local branch
    local local_tip remote_tip
    local_tip=$(git -C "${monorepo_path}" rev-parse "${mono_branch}" 2>/dev/null || echo "")
    remote_tip=$(git -C "${monorepo_path}" rev-parse "${mono_remote}/${mono_branch}" 2>/dev/null || echo "")

    if [[ -z "${remote_tip}" ]]; then
        echo "ERROR: ${mono_remote}/${mono_branch} not found in monorepo." >&2
        exit 1
    fi

    if [[ "${local_tip}" == "${remote_tip}" ]]; then
        echo "    Monorepo branch already up to date."
    elif [[ -z "${local_tip}" ]]; then
        echo "    Creating local branch ${mono_branch} at ${remote_tip:0:12}"
        git -C "${monorepo_path}" branch "${mono_branch}" "${mono_remote}/${mono_branch}" 2>&1
    else
        echo "    Updating ${mono_branch}: ${local_tip:0:12} -> ${remote_tip:0:12}"
        # Check if branch is checked out (branch -f fails on checked-out branches)
        local mono_checked_out
        mono_checked_out=$(git -C "${monorepo_path}" branch --show-current 2>/dev/null || echo "")
        if [[ "${mono_checked_out}" == "${mono_branch}" ]]; then
            git -C "${monorepo_path}" merge --ff-only "${mono_remote}/${mono_branch}" 2>&1
        else
            git -C "${monorepo_path}" branch -f "${mono_branch}" "${mono_remote}/${mono_branch}" 2>&1
        fi
    fi

    # Step 3: Re-split the updated branch (skip if already current)
    #
    # We avoid `subtree split --branch=<name>` because it has an ancestry
    # check that fails after export. Export sets the split branch to a
    # submodule commit (via branch -f) to preserve hash identity. When sync
    # later re-splits, the new split commits have a different lineage than
    # the submodule commit, so the ancestry check fails with:
    #   "fatal: branch '<name>' is not an ancestor of commit '<sha>'"
    # Instead, we split without --branch (outputs SHA to stdout) and then
    # force-update the branch ourselves.
    echo ""
    local existing_split_sha=""
    existing_split_sha=$(git -C "${monorepo_path}" rev-parse "${split_branch_name}" 2>/dev/null || echo "")
    if [[ -n "${existing_split_sha}" ]]; then
        local split_tree mono_subtree_tree
        split_tree=$(git -C "${monorepo_path}" rev-parse "${split_branch_name}^{tree}" 2>/dev/null || echo "")
        mono_subtree_tree=$(git -C "${monorepo_path}" rev-parse "${mono_branch}:${prefix}" 2>/dev/null || echo "")
        if [[ -n "${split_tree}" && "${split_tree}" == "${mono_subtree_tree}" ]]; then
            echo "==> Split branch '${split_branch_name}' is already up to date. Skipping re-split."
        else
            echo "==> Re-splitting '${prefix}' from '${mono_branch}'..."
            local new_split_sha
            new_split_sha=$(git -C "${monorepo_path}" subtree split \
                --prefix="${prefix}" "${mono_branch}")
            git -C "${monorepo_path}" branch -f "${split_branch_name}" "${new_split_sha}"
        fi
    else
        echo "==> Splitting '${prefix}' from '${mono_branch}'..."
        local new_split_sha
        new_split_sha=$(git -C "${monorepo_path}" subtree split \
            --prefix="${prefix}" "${mono_branch}")
        git -C "${monorepo_path}" branch -f "${split_branch_name}" "${new_split_sha}"
    fi

    # Step 4: Fetch the updated split into the submodule
    echo ""
    echo "==> Fetching updated split branch..."
    if is_blobless_remote "${remote}"; then
        git fetch --filter=blob:none "${remote}" 2>&1
    else
        git fetch "${remote}" 2>&1
    fi

    # Step 5: Rebase local work onto updated split branch
    echo ""
    local local_sha remote_sha
    local_sha=$(git rev-parse HEAD)
    remote_sha=$(git rev-parse "${remote_split}")

    if [[ "${local_sha}" == "${remote_sha}" ]]; then
        echo "    Already up to date — no new commits."
        echo ""
        echo "==> Sync complete."
        return 0
    fi

    echo "==> Rebasing local work onto updated split branch..."
    git rebase "${remote_split}" 2>&1

    local new_head
    new_head=$(git rev-parse HEAD)
    if [[ "${new_head}" == "${remote_sha}" ]]; then
        echo "    No local commits to rebase — fast-forwarded."
    fi

    echo ""
    echo "==> Sync complete."
}

# --- Subcommand: verify -------------------------------------------------------

cmd_verify() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} verify [monorepo-branch]"
        echo ""
        echo "Verify that all three branches (submodule, split, monorepo subtree)"
        echo "are in sync. Run this inside the submodule directory."
        echo ""
        echo "Checks:"
        echo "  1. Split branch commit == Submodule HEAD (same hash)"
        echo "  2. Monorepo subtree tree == Split branch tree (same tree object)"
        echo ""
        echo "Arguments:"
        echo "  monorepo-branch   Branch in monorepo to check (default: tracked branch)"
        exit 0
    fi

    local mono_branch_override="${1:-}"

    # Read config
    require_bridge_config || exit 1
    local monorepo_path
    monorepo_path=$(resolve_monorepo_path) || exit 1
    local prefix
    prefix=$(bridge_config_get "prefix")
    local split_prefix
    split_prefix=$(bridge_config_get "split-prefix" "bridge-split")

    # Resolve monorepo branch
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    local mono_branch=""
    if [[ -n "${mono_branch_override}" ]]; then
        mono_branch="${mono_branch_override}"
    elif mono_branch=$(git config --local --get "branch.${current_branch}.bridge-tracks" 2>/dev/null) && [[ -n "${mono_branch}" ]]; then
        : # already set
    else
        echo "ERROR: No tracked monorepo branch. Specify it explicitly:" >&2
        echo "       ${PROG} verify <monorepo-branch>" >&2
        exit 1
    fi

    local split_branch="${split_prefix}/${mono_branch}"
    local pass=true

    echo "==> Verifying bridge sync"
    echo "    Submodule branch: ${current_branch}"
    echo "    Split branch:     ${split_branch}"
    echo "    Monorepo branch:  ${mono_branch}"
    echo "    Prefix:           ${prefix}"
    echo ""

    # Check 1: Split branch commit == Submodule HEAD
    local split_sha sub_sha
    split_sha=$(git -C "${monorepo_path}" rev-parse "${split_branch}" 2>/dev/null || echo "NOT_FOUND")
    sub_sha=$(git rev-parse HEAD)

    echo "    Split branch SHA:     ${split_sha:0:12}"
    echo "    Submodule HEAD SHA:   ${sub_sha:0:12}"
    if [[ "${split_sha}" == "${sub_sha}" ]]; then
        echo "    CHECK 1 PASS: same commit hash"
    else
        echo "    CHECK 1 FAIL: commit hashes differ"
        pass=false
    fi

    echo ""

    # Check 2: Monorepo subtree tree == Split branch tree
    local mono_subtree split_tree
    mono_subtree=$(git -C "${monorepo_path}" rev-parse "${mono_branch}:${prefix}" 2>/dev/null || echo "NOT_FOUND")
    split_tree=$(git -C "${monorepo_path}" rev-parse "${split_branch}^{tree}" 2>/dev/null || echo "NOT_FOUND")

    echo "    Monorepo subtree tree: ${mono_subtree:0:12}"
    echo "    Split branch tree:     ${split_tree:0:12}"
    if [[ "${mono_subtree}" == "${split_tree}" ]]; then
        echo "    CHECK 2 PASS: same tree object"
    else
        echo "    CHECK 2 FAIL: tree objects differ"
        pass=false
    fi

    echo ""
    if [[ "${pass}" == true ]]; then
        echo "==> All checks passed. Branches are in sync."
    else
        echo "==> FAILED: Branches are out of sync."
        exit 1
    fi
}

# --- Subcommand: reset --------------------------------------------------------

cmd_reset() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: ${PROG} reset [options] [monorepo-branch]"
        echo ""
        echo "Reset all three branches (submodule, split, monorepo) to undo an export."
        echo "Run this inside the submodule directory."
        echo ""
        echo "Options:"
        echo "  --target=<sha>   Commit SHA to reset to (skips interactive prompt)"
        echo ""
        echo "Steps performed:"
        echo "  1. Ask user for the new HEAD commit (or use --target)"
        echo "  2. Reset submodule branch (git reset --hard)"
        echo "  3. Reset split branch to the same SHA (shared history)"
        echo "  4. Reset monorepo branch to the commit whose subtree matches"
        echo "  5. Verify all three branches are in sync"
        echo ""
        echo "Arguments:"
        echo "  monorepo-branch   Branch in monorepo to reset (default: tracked branch)"
        exit 0
    fi

    local mono_branch_override=""
    local target_sha_override=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target=*) target_sha_override="${1#--target=}"; shift ;;
            -*) echo "ERROR: Unknown option: $1" >&2; exit 1 ;;
            *) mono_branch_override="$1"; shift ;;
        esac
    done

    # Read config
    require_bridge_config || exit 1
    local monorepo_path
    monorepo_path=$(resolve_monorepo_path) || exit 1
    local prefix
    prefix=$(bridge_config_get "prefix")
    local split_prefix
    split_prefix=$(bridge_config_get "split-prefix" "bridge-split")

    # Resolve monorepo branch
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    local mono_branch=""
    if [[ -n "${mono_branch_override}" ]]; then
        mono_branch="${mono_branch_override}"
    elif mono_branch=$(git config --local --get "branch.${current_branch}.bridge-tracks" 2>/dev/null) && [[ -n "${mono_branch}" ]]; then
        : # already set
    else
        echo "ERROR: No tracked monorepo branch. Specify it explicitly:" >&2
        echo "       ${PROG} reset <monorepo-branch>" >&2
        exit 1
    fi

    local split_branch="${split_prefix}/${mono_branch}"

    # Get target SHA: from --target flag or interactive prompt
    local target_sha=""
    if [[ -n "${target_sha_override}" ]]; then
        target_sha="${target_sha_override}"
    else
        echo "==> Recent commits on '${current_branch}':"
        git log --oneline -10
        echo ""
        target_sha=$(read_input "Enter the commit SHA for new HEAD: ")
        if [[ -z "${target_sha}" ]]; then
            echo "ERROR: No commit specified. Use --target=<sha> in non-interactive mode." >&2
            exit 1
        fi
    fi

    # Validate the SHA
    if ! git rev-parse --verify "${target_sha}" &>/dev/null; then
        echo "ERROR: '${target_sha}' is not a valid commit." >&2
        exit 1
    fi
    target_sha=$(git rev-parse "${target_sha}")

    echo ""
    echo "==> Resetting all branches to ${target_sha:0:12}"
    echo "    Submodule branch: ${current_branch}"
    echo "    Split branch:     ${split_branch}"
    echo "    Monorepo branch:  ${mono_branch}"

    if ! confirm_prompt "    Proceed with reset?"; then
        echo "    Aborted." >&2
        exit 1
    fi

    # Step 1: Reset submodule branch
    echo ""
    echo "==> Step 1: Resetting submodule branch '${current_branch}'..."
    git reset --hard "${target_sha}" 2>&1

    # Step 2: Reset split branch (same commit hash — shared history)
    echo ""
    echo "==> Step 2: Resetting split branch '${split_branch}'..."
    local mono_original_branch
    mono_original_branch=$(git -C "${monorepo_path}" branch --show-current 2>/dev/null || echo "")

    if [[ "${mono_original_branch}" == "${split_branch}" ]]; then
        git -C "${monorepo_path}" reset --hard "${target_sha}" 2>&1
    else
        git -C "${monorepo_path}" branch -f "${split_branch}" "${target_sha}" 2>&1
    fi

    # Step 3: Reset monorepo branch
    # Find the monorepo commit whose subtree tree matches the target
    echo ""
    echo "==> Step 3: Resetting monorepo branch '${mono_branch}'..."
    local target_tree
    target_tree=$(git rev-parse "${target_sha}^{tree}")

    local mono_target=""
    while IFS= read -r sha; do
        local subtree
        subtree=$(git -C "${monorepo_path}" rev-parse "${sha}:${prefix}" 2>/dev/null || true)
        if [[ "${subtree}" == "${target_tree}" ]]; then
            mono_target="${sha}"
            break
        fi
    done < <(git -C "${monorepo_path}" log --format="%H" "${mono_branch}")

    if [[ -z "${mono_target}" ]]; then
        echo "ERROR: Could not find matching monorepo commit for tree ${target_tree:0:12}." >&2
        echo "       The monorepo branch may not contain a commit with this subtree." >&2
        exit 1
    fi

    echo "    Found matching monorepo commit: ${mono_target:0:12}"

    if [[ "${mono_original_branch}" == "${mono_branch}" ]]; then
        git -C "${monorepo_path}" reset --hard "${mono_target}" 2>&1
    else
        git -C "${monorepo_path}" branch -f "${mono_branch}" "${mono_target}" 2>&1
    fi

    # Restore monorepo original branch if needed
    local current_mono_branch
    current_mono_branch=$(git -C "${monorepo_path}" branch --show-current 2>/dev/null || echo "")
    if [[ -n "${mono_original_branch}" && "${current_mono_branch}" != "${mono_original_branch}" ]]; then
        git -C "${monorepo_path}" checkout "${mono_original_branch}" 2>/dev/null || true
    fi

    # Step 4: Verify
    echo ""
    echo "==> Verifying sync after reset..."
    cmd_verify "${mono_branch}"
}

# --- Main dispatcher ---------------------------------------------------------

main() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: ${PROG} <command> [args]"
        echo ""
        echo "Commands:"
        echo "  setup    Set up the bridge (run from submodule)"
        echo "  split    Split monorepo subdirectory into standalone branch"
        echo "  export   Export submodule commits to monorepo (fetch + subtree merge)"
        echo "  sync     Pull latest monorepo changes into submodule (split + rebase)"
        echo "  reset    Reset all three branches to undo an export"
        echo "  verify   Verify all three branches are in sync"
        echo ""
        echo "Run '${PROG} <command> --help' for command-specific usage."
        exit 1
    fi

    local cmd="$1"
    shift

    case "${cmd}" in
        setup)  cmd_setup "$@" ;;
        split)  cmd_split "$@" ;;
        export) cmd_export "$@" ;;
        sync)   cmd_sync "$@" ;;
        reset)  cmd_reset "$@" ;;
        verify) cmd_verify "$@" ;;
        -h|--help)
            main
            ;;
        --version)
            echo "${PROG} ${VERSION}"
            ;;
        *)
            echo "ERROR: Unknown command '${cmd}'" >&2
            echo "Run '${PROG} --help' for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
